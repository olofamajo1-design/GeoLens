{
  "name": "geolens-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "build": "react-router build",
    "preview": "vite preview --host 0.0.0.0 --port 4173 --strictPort",
    "typecheck": "wrangler types && react-router typegen && tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:smoke": "node --test tests/smoke/worker.test.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run test:smoke",
    "generate:schemas": "node scripts/generate-validators.mjs",
    "predev": "npm run generate:schemas",
    "prebuild": "npm run generate:schemas",
    "pretypecheck": "npm run generate:schemas",
    "pretest": "npm run generate:schemas",
    "test:database": "node --test tests/integration/supabase.test.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "isbot": "5.2.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.70.1",
    "@playwright/test": "1.65.1",
    "@react-router/dev": "8.5.2",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "wrangler": "4.165.0"
  }
}
