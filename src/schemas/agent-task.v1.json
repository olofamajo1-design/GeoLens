{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "agent-task",
  "type": "object",
  "required": [
    "schemaVersion",
    "storyId",
    "taskId",
    "agentId",
    "attempt",
    "topic"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "storyId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "taskId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "agentId": {
      "enum": [
        "GL-AGENT-001",
        "GL-AGENT-002",
        "GL-AGENT-003",
        "GL-AGENT-004",
        "GL-AGENT-005",
        "GL-AGENT-006",
        "GL-AGENT-007",
        "GL-AGENT-008"
      ]
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "topic": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    }
  }
}
