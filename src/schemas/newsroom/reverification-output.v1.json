{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.geolens.invalid/newsroom/reverification-output.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "synthetic",
    "runId",
    "eventId",
    "storyId",
    "attemptId",
    "round",
    "stage",
    "version",
    "status",
    "checkedClaims",
    "unresolved",
    "critical"
  ],
  "properties": {
    "contractVersion": {
      "const": 1
    },
    "synthetic": {
      "const": true
    },
    "runId": {
      "$ref": "https://schemas.geolens.invalid/newsroom/research-common.v1.json#/$defs/id"
    },
    "eventId": {
      "$ref": "https://schemas.geolens.invalid/newsroom/research-common.v1.json#/$defs/id"
    },
    "storyId": {
      "$ref": "https://schemas.geolens.invalid/newsroom/research-common.v1.json#/$defs/id"
    },
    "attemptId": {
      "$ref": "https://schemas.geolens.invalid/newsroom/research-common.v1.json#/$defs/id"
    },
    "round": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "stage": {
      "const": "reverification"
    },
    "version": {
      "$ref": "https://schemas.geolens.invalid/newsroom/production-common.v1.json#/$defs/version"
    },
    "status": {
      "type": "string",
      "enum": [
        "verified",
        "hold"
      ]
    },
    "checkedClaims": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.geolens.invalid/newsroom/research-common.v1.json#/$defs/id"
      },
      "minItems": 0,
      "maxItems": 48,
      "uniqueItems": true
    },
    "unresolved": {
      "$ref": "https://schemas.geolens.invalid/newsroom/production-common.v1.json#/$defs/proposals"
    },
    "critical": {
      "$ref": "https://schemas.geolens.invalid/newsroom/production-common.v1.json#/$defs/critical"
    }
  }
}
