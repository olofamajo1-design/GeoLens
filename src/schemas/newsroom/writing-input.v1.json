{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.geolens.invalid/newsroom/writing-input.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "synthetic",
    "runId",
    "eventId",
    "storyId",
    "attemptId",
    "round",
    "stage",
    "researchId",
    "formats",
    "headlines",
    "standfirst",
    "material",
    "sourceRegister",
    "revisionInstructions"
  ],
  "properties": {
    "contractVersion": {
      "const": 1
    },
    "synthetic": {
      "const": true
    },
    "runId": {
      "$ref": "https://schemas.geolens.invalid/newsroom/research-common.v1.json#/$defs/id"
    },
    "eventId": {
      "$ref": "https://schemas.geolens.invalid/newsroom/research-common.v1.json#/$defs/id"
    },
    "storyId": {
      "$ref": "https://schemas.geolens.invalid/newsroom/research-common.v1.json#/$defs/id"
    },
    "attemptId": {
      "$ref": "https://schemas.geolens.invalid/newsroom/research-common.v1.json#/$defs/id"
    },
    "round": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "stage": {
      "const": "writing"
    },
    "researchId": {
      "$ref": "https://schemas.geolens.invalid/newsroom/research-common.v1.json#/$defs/id"
    },
    "formats": {
      "$ref": "https://schemas.geolens.invalid/newsroom/production-common.v1.json#/$defs/formats"
    },
    "headlines": {
      "$ref": "https://schemas.geolens.invalid/newsroom/production-common.v1.json#/$defs/headlines"
    },
    "standfirst": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "material": {
      "$ref": "https://schemas.geolens.invalid/newsroom/production-common.v1.json#/$defs/material"
    },
    "sourceRegister": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.geolens.invalid/newsroom/research-common.v1.json#/$defs/id"
      },
      "minItems": 0,
      "maxItems": 48,
      "uniqueItems": true
    },
    "revisionInstructions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 320
      },
      "minItems": 0,
      "maxItems": 16
    }
  }
}
