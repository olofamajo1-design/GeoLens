{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.geolens.invalid/newsroom/visual-input.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "synthetic",
    "runId",
    "eventId",
    "storyId",
    "attemptId",
    "round",
    "stage",
    "candidates",
    "revisionInstructions"
  ],
  "properties": {
    "contractVersion": {
      "const": 1
    },
    "synthetic": {
      "const": true
    },
    "runId": {
      "$ref": "https://schemas.geolens.invalid/newsroom/research-common.v1.json#/$defs/id"
    },
    "eventId": {
      "$ref": "https://schemas.geolens.invalid/newsroom/research-common.v1.json#/$defs/id"
    },
    "storyId": {
      "$ref": "https://schemas.geolens.invalid/newsroom/research-common.v1.json#/$defs/id"
    },
    "attemptId": {
      "$ref": "https://schemas.geolens.invalid/newsroom/research-common.v1.json#/$defs/id"
    },
    "round": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "stage": {
      "const": "visual"
    },
    "candidates": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.geolens.invalid/newsroom/production-common.v1.json#/$defs/visual"
      },
      "minItems": 0,
      "maxItems": 16
    },
    "revisionInstructions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 320
      },
      "minItems": 0,
      "maxItems": 16
    }
  }
}
